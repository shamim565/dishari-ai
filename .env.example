DEBUG=1
SECRET_KEY=change-me
ALLOWED_HOSTS=*
# Must be reachable from the passenger's phone (e.g. http://192.168.1.20:8000 or an HTTPS tunnel)
BASE_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=
# For cloudflared/ngrok demos add e.g.: https://*.trycloudflare.com
OPS_PIN=1234
KIOSK_IDLE_SECONDS=120

# Production (Contabo VPS — see docs/deployment-vps.md):
# DEBUG=0
# SECRET_KEY=<openssl rand -base64 48>
# ALLOWED_HOSTS=dishari.tourismbangladesh.live,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://dishari.tourismbangladesh.live
# BASE_URL=https://dishari.tourismbangladesh.live
# DB_PATH=/data/db.sqlite3    # Docker volume mount; default ./db.sqlite3

# AI provider layer
# CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-4o-mini
# VISION_PROVIDER=openai
# VISION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
# GEMINI_API_KEY=          # free AI Studio key (https://aistudio.google.com/apikey)

# Voice (TTS): gemini = free AI Studio voice, azure = fallback when gemini fails
# TTS_PROVIDER=gemini
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Kore
# Live API — the main voice assistant (speech-to-speech). No mode toggle:
# emergency override is /assistant/?voice=tts (classic TTS pipeline).
# Live model options (verified 2026-10):
#   gemini-3.8-live                               — current, recommended (fastest first audio)
#   gemini-3.8-live-extended-thinking             — deeper reasoning (thinking level auto-configured)
#   gemini-3.1-flash-live-preview                 — legacy preview, works
#   gemini-2.5-flash-native-audio-preview-12-2025 — legacy 2.5 native audio, works (slower)
# GEMINI_LIVE_MODEL=gemini-3.8-live

# Azure Speech (guaranteed bn-BD voice)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia
